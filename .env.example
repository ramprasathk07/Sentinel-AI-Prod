# ── Project ──────────────────────────────────────────────────
PROJECT_NAME=Sentinel-AI
DATABASE_URL=sqlite:///./sentinel.db

# ── LLM Backend ──────────────────────────────────────────────
# Choose one: "ollama", "vllm", or "aisa"
LLM_BACKEND=ollama

# Option A — Ollama (default, easiest)
OLLAMA_BASE_URL=http://localhost:11434
VERDICT_MODEL=qwen2.5-coder:7b

# Option B — vLLM (uncomment to use)
# LLM_BACKEND=vllm
# VLLM_BASE_URL=http://localhost:8000
# VERDICT_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# Option C — AISA.one gateway (uncomment to use)
# LLM_BACKEND=aisa
# AISA_BASE_URL=https://api.aisa.one/v1
# AISA_API_KEY=your_aisa_key_here

# ── Google ADK / Gemini (optional — only if running ADK agents) ─
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# ── GitHub App (required for live webhook pipeline) ──────────
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=./secrets/sentinel-app.private-key.pem

# ── Vulnerability APIs ───────────────────────────────────────
# Optional NVD API key raises rate limit from 5 → 50 req / 30s
NVD_API_KEY=
OSV_API_URL=https://api.osv.dev/v1
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# ── Registry APIs ────────────────────────────────────────────
NPM_REGISTRY_URL=https://registry.npmjs.org
PYPI_API_URL=https://pypi.org
CRATES_IO_API_URL=https://crates.io/api/v1

# ── One-Week Rule ────────────────────────────────────────────
ONE_WEEK_DAYS=7

# ── Sentinel Watcher ─────────────────────────────────────────
SLACK_WEBHOOK_URL=
WATCHER_INTERVAL_MINUTES=15

# ── Sentinel v2 Features ─────────────────────────────────────
# GitHub Checks API (requires read&write permissions)
SENTINEL_GH_CHECKS_ENABLED=false

# GitHub OAuth Connect
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8005/api/v1/github/callback
SENTINEL_TOKEN_ENC_KEY=

# Auto-Pentest gate (gated off by default)
SENTINEL_PENTEST_AUTO=false

# RL Data Collection Pipeline
RL_DATA_DIR=data/rl
RL_REWARD_WEIGHTS=0.6,0.2,0.2
SENTINEL_RL_TRACE_ENABLED=true
SENTINEL_RL_TRACE_DAILY_LIMIT=200
SENTINEL_RL_TRACE_MODEL_AISA=deepseek-ai/DeepSeek-V3
SENTINEL_RL_TRACE_MODEL_VLLM=Qwen/Qwen2.5-Coder-32B-Instruct
SENTINEL_RL_TRACE_MODEL_OLLAMA=
SENTINEL_RL_TRACE_FORCE_BACKEND=

