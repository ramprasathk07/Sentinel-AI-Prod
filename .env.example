# ── Project ──────────────────────────────────────────────────
PROJECT_NAME=Sentinel-AI
DATABASE_URL=sqlite:///./sentinel.db

# ── LLM Backend ──────────────────────────────────────────────
# Choose one: "ollama", "vllm", or "aisa"
LLM_BACKEND=ollama

# Option A — Ollama (default, easiest)
OLLAMA_BASE_URL=http://localhost:11434
VERDICT_MODEL=qwen2.5-coder:7b

# Option B — vLLM (uncomment to use)
# LLM_BACKEND=vllm
# VLLM_BASE_URL=http://localhost:8000
# VERDICT_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# Option C — AISA.one gateway (uncomment to use)
# LLM_BACKEND=aisa
# AISA_BASE_URL=https://api.aisa.one/v1
# AISA_API_KEY=your_aisa_key_here

# ── Google ADK / Gemini (optional — only if running ADK agents) ─
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# ── GitHub App (required for live webhook pipeline) ──────────
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=./secrets/sentinel-app.private-key.pem

# ── Vulnerability APIs ───────────────────────────────────────
# Optional NVD API key raises rate limit from 5 → 50 req / 30s
NVD_API_KEY=
OSV_API_URL=https://api.osv.dev/v1
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# ── Registry APIs ────────────────────────────────────────────
NPM_REGISTRY_URL=https://registry.npmjs.org
PYPI_API_URL=https://pypi.org
CRATES_IO_API_URL=https://crates.io/api/v1

# ── One-Week Rule ────────────────────────────────────────────
ONE_WEEK_DAYS=7

# ── Sentinel Watcher ─────────────────────────────────────────
SLACK_WEBHOOK_URL=
WATCHER_INTERVAL_MINUTES=15
